[Unit]
Description=North Echo game server (matches)
After=network-online.target
Wants=network-online.target
PartOf=northecho.target

[Service]
Type=simple
User=northecho
Group=northecho
# current/ points at the live release (deploy.sh switches it atomically).
WorkingDirectory=/var/www/northecho/current
EnvironmentFile=/etc/northecho/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/northecho/current/apps/game/dist/main.mjs
Restart=always
RestartSec=2
# Running matches may finish before a restart (DRAIN_SEC, 120 s by default).
TimeoutStopSec=150
KillMode=mixed
SyslogIdentifier=northecho-game
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/northecho

[Install]
WantedBy=northecho.target
