[Unit]
Description=North Echo autodeploy from GitHub
After=network-online.target

[Service]
Type=oneshot
# Installed by setup.sh and refreshed by every successful deploy.
ExecStart=/usr/local/sbin/northecho-deploy
EnvironmentFile=-/etc/northecho/deploy.env
SyslogIdentifier=northecho-deploy
# npm ci + build, plus a game server that may drain running matches for 150 s.
TimeoutStartSec=1200
Nice=10
