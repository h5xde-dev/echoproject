{
  "name": "north-echo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @echo/web",
    "dev:services": "node tools/dev-services.mjs",
    "build": "npm run check:text && npm run typecheck && npm run build --workspaces --if-present",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/node-kit --noEmit && tsc -p apps/web --noEmit && tsc -p apps/api --noEmit && tsc -p apps/meta --noEmit && tsc -p apps/game --noEmit",
    "check:text": "node tools/check-text.mjs",
    "test": "node --test tests/",
    "test:services": "node tests/run-services.mjs",
    "test:arenas": "npm run test:arenas -w @echo/web",
    "test:server": "npm run test:server -w @echo/web",
    "test:online": "npm run test:online -w @echo/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  }
}
